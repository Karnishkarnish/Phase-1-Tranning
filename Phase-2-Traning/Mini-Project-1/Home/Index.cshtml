@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4 dynamic-heading">Welcome</h1>
    <a asp-controller="Home" asp-action="Expences" class="btn btn-primary dynamic-btn">Overview</a>
    <a asp-controller="Home" asp-action="CreateExpencesEdit" class="btn btn-secondary dynamic-btn">Create New</a>
</div>


<style>
   
    .dynamic-heading {
        font-size: 3rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 30px; 
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1); 
    }

   
    .dynamic-btn {
        font-size: 1.2rem;
        padding: 12px 25px; 
        margin: 10px; 
        border-radius: 8px; 
        transition: all 0.3s ease; 
    }

  
    .btn-primary.dynamic-btn {
        background-color: #5bc0de;
        border-color: #5bc0de;
    }

        .btn-primary.dynamic-btn:hover {
            background-color: #39a9c1; 
            border-color: #39a9c1;
            transform: scale(1.05);
        }

    .btn-secondary.dynamic-btn {
        background-color: #6c757d; 
        border-color: #6c757d;
    }

        .btn-secondary.dynamic-btn:hover {
            background-color: #5a6368;
            border-color: #5a6368;
            transform: scale(1.05); 
        }

  
  
        .dynamic-heading

    {
        font-size: 2.5rem;
    }

    .dynamic-btn {
        font-size: 1rem;
        padding: 10px 20px;
    }

    
</style>
