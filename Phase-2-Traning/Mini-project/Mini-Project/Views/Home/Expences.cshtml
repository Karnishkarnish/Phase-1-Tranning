@{
    ViewData["Title"] = "Expences";
}
@model List<Expence>

<div class="text-center">
    <h1 class="display-4">Expences</h1>
    <hr />
    <h3>Total expences $@ViewBag.Expences</h3>
</div>

<!-- Table styling -->
<table class="table table-striped expences-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Value</th>
            <th>Des</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var expence in Model)
        {
            <tr>
                <td>@expence.Id</td>
                <td>@expence.Value</td>
                <td>@expence.Des</td>
                <td>
                    <a asp-action="CreateExpencesEdit" asp-route-id="@expence.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteExpence" asp-route-id="@expence.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Custom Styles -->
<style>
    .expences-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

        .expences-table th, .expences-table td {
            padding: 12px;
            text-align: left;
            border: 1px solid #ddd;
        }

        .expences-table th {
            background-color: #007bff;
            color: white;
        }

        .expences-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .expences-table tr:hover {
            background-color: #f1f1f1;
        }

    /* Style for buttons in the Action column */
    .btn {
        text-decoration: none;
        color: white;
        padding: 8px 15px;
        margin-right: 10px;
        border-radius: 4px;
    }

    /* Specific button styles */
    .btn-warning {
        background-color: #ffc107;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .btn-danger {
        background-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    /* Center the action buttons in each row */
    .table td a {
        display: inline-block;
        margin: 5px;
    }

    /* Overall table style */
    .table {
        background-color: #fff;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        overflow: hidden;
    }
</style>
