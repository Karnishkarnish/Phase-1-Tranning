<style>
    .movie-table {
        border-radius: 10px;
        overflow: hidden;
        /* background: #fff; */
    }
    .movie-table th {
        /* background-color: #f8f9fa; */
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .movie-table td {
        /* background-color: #ffffff; */
    }
    .movie-table tr:hover td {
        background-color: #f1f1f1;
    }
    .page-title {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: bold;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
    }
    .movie-poster {
        display: block;
        max-width: 250px;
        margin: 0 auto 20px auto;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
    }
    .movie-poster:hover {
        transform: scale(1.05);
    }
</style>

<div class="container mt-4">
    <h1 class="text-center text-primary mb-4 page-title">@ViewData["MovieTitle"]</h1>

    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSEDCc_E_Fq0wlZ5p7XyZWs90JD6W3Qjw1fZg&s"
         alt="Coolie Movie Poster" class="movie-poster" />

    <table class="table table-striped table-bordered w-75 mx-auto shadow-sm movie-table">
        <tbody>
            <tr>
                <th class="w-25">Description</th>
                <td>@ViewData["Description"]</td>
            </tr>
            <tr>
                <th>Director</th>
                <td>@ViewData["Director"]</td>
            </tr>
            <tr>
                <th>Release Date</th>
                <td>@ViewData["ReleaseDate"]</td>
            </tr>
        </tbody>
    </table>
</div>
