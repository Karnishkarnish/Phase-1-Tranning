@model MiniProject.Models.Audience

<h2 class="text-center mb-4">Audience Details</h2>

<table class="table table-bordered table-striped w-50 mx-auto shadow-lg">
    <tbody>
        <tr>
            <th class="bg-primary text-white w-25">Name</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th class="bg-primary text-white">Gender</th>
            <td>@Model.Gender</td>
        </tr>
        <tr>
            <th class="bg-primary text-white">Age</th>
            <td>@Model.Age</td>
        </tr>
        <tr>
            <th class="bg-primary text-white">DOB</th>
            <td>@Model.Birthday</td>
        </tr>
    </tbody>
</table>

<div class="text-center mt-3">
    <a class="btn btn-info" asp-action="List">Back to List</a>
</div>
